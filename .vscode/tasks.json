
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Kotlin: Compile",
            "type": "shell",
            "command": "/home/user/.sdkman/candidates/kotlin/current/bin/kotlinc",
            "args": [
                "${file}",
                "-include-runtime",
                "-d",
                "${fileDirname}/${fileBasenameNoExtension}.jar"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Kotlin: Run",
            "type": "shell",
            "command": "java",
            "args": [
                "-jar",
                "${fileDirname}/${fileBasenameNoExtension}.jar"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "Kotlin: Compile",
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
